<mah:MetroWindow x:Class="DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        mc:Ignorable="d"
        Title="heirowDebug" Icon="/heirowDebug.WPF;component/Assets/heirowDebug.ico" Height="450" Width="800" Background="#FF191919">
    <mah:MetroWindow.Resources>
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF171C20"/>
            <Setter Property="Foreground" Value="#FFF1F5F3"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FF2C5A43"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF237044"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF171C20"/>
            <Setter Property="Foreground" Value="#FFF1F5F3"/>
            <Setter Property="BorderBrush" Value="#FF4A555E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter Margin="8,0,28,0" VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                      Fill="#FF9EAAA4" Data="M 0 0 L 8 0 L 4 5 Z"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="0,3,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300" Background="#FF171C20" BorderBrush="#FF4A555E"
                                        BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="150" MaxWidth="650"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>
        <TreeView x:Name="Watchers" Foreground="#FF7F7F7F" Background="#FF0E0E0E" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter, AncestorLevel=1}}" />
                </ItemsPanelTemplate>
            </TreeView.ItemsPanel>
        </TreeView>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#FF343C43"
                      ShowsPreview="True" Cursor="SizeWE"/>
        <Grid x:Name="Plot" Background="#FF272727" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="ChartCanvas" Margin="0,54,0,0" Background="#FF202428" ClipToBounds="True"/>
            <Polygon x:Name="p" Visibility="Collapsed" Fill="#A8A50000" Stroke="#FFCC0D0D" ClipToBounds="False" StrokeLineJoin="Round" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" Stretch="Fill">
                <Polygon.Points>
                    <PointCollection x:Name="Points">

                    </PointCollection>
                </Polygon.Points>
            </Polygon>
            <Canvas x:Name="SpatialCanvas" Margin="0,54,0,0" Background="#FF202428" Visibility="Collapsed" ClipToBounds="True"/>
            <Canvas x:Name="SpatialAxisLeft" Visibility="Collapsed" Width="40" HorizontalAlignment="Left" ClipToBounds="True"/>
            <Canvas x:Name="SpatialAxisBottom" Visibility="Collapsed" Height="20" VerticalAlignment="Bottom" ClipToBounds="True"/>
            <TextBlock x:Name="LowLabel" Visibility="Collapsed" Foreground="WhiteSmoke" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5,0,0,5">0</TextBlock>
            <TextBlock x:Name="HighLabel" Visibility="Collapsed" Foreground="WhiteSmoke" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,5,5,0">100</TextBlock>
            <TextBlock x:Name="EmptyGraphMessage" Margin="24,78,24,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#FF8E9993" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Select a value to visualize its live history."/>
            <StackPanel x:Name="ValueActions" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,8" Panel.ZIndex="4">
                <WrapPanel HorizontalAlignment="Center">
                <Button x:Name="AddWatchButton" Content="Add Watch" Padding="20,10" FontSize="14" Background="#FF2D2D30" Foreground="WhiteSmoke" BorderBrush="#FF3F3F46"/>
                <TextBox x:Name="EditValueTextBox" Margin="8,0" MinWidth="160" MaxWidth="240" Padding="6" VerticalContentAlignment="Center" SpellCheck.IsEnabled="False"/>
                <mah:ToggleSwitch x:Name="SetBackingFieldToggle" Margin="0,0,8,0" Header="Also set backing field"
                                  IsOn="False" Visibility="Collapsed"
                                  ToolTip="After the property setter runs, also update its matching underscore field."/>
                <Button x:Name="ApplyValueButton" Content="Apply live value" Padding="12,6"/>
                </WrapPanel>
                <TextBlock x:Name="EditStatus" Foreground="LightGray" TextWrapping="Wrap" MaxWidth="320"/>
            </StackPanel>
            <CheckBox x:Name="InvertSpatialCheckBox" Content="Invert" Foreground="WhiteSmoke" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="45,5,0,0" Visibility="Collapsed" FontSize="10" IsChecked="True"/>
            <TextBox x:Name="StringValueTextBox" Margin="0,54,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap" Background="#FF272727" Foreground="WhiteSmoke" BorderThickness="0" Visibility="Collapsed" FontFamily="Consolas" FontSize="12" Padding="5"/>
            <Border VerticalAlignment="Top" Height="54" Background="#FF181C20" BorderBrush="#FF343C43" BorderThickness="0,0,0,1" Panel.ZIndex="10">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VisualizationTitle" Foreground="White" FontWeight="SemiBold" Text="Live visualization"/>
                        <TextBlock x:Name="VisualizationSummary" Foreground="#FF93A099" FontSize="10" Text="No value selected"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                        <CheckBox x:Name="CompactGapsCheckBox" Content="Compact gaps" Foreground="#FFD8DFDB"
                                  Checked="TimelineSpacing_Changed" Unchecked="TimelineSpacing_Changed"/>
                        <Slider x:Name="GapCompressionSlider" Width="92" Height="14" Minimum="0" Maximum="100" Value="100"
                                IsEnabled="{Binding IsChecked, ElementName=CompactGapsCheckBox}"
                                ToolTip="Blend from real elapsed time to evenly spaced changes"
                                ValueChanged="TimelineSpacing_Changed"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="View" Foreground="#FF9CA7A1" VerticalAlignment="Center" Margin="4,0,7,0"/>
                    <ComboBox x:Name="VisualizationModeComboBox" Grid.Column="3" Width="126" Height="28" SelectedIndex="0"
                              Style="{StaticResource DarkComboBoxStyle}"
                              SelectionChanged="VisualizationModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Auto"/>
                        <ComboBoxItem Content="Time series"/>
                        <ComboBoxItem Content="Spatial overlay"/>
                        <ComboBoxItem Content="Events"/>
                    </ComboBox>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="TimelineGrid" Background="#FF212121" Grid.Column="2" Margin="0,0,0,0" Grid.Row="1">
            <mah:RangeSlider x:Name="Slider" Margin="10,10,10,10" MinRangeWidth="0" UpperValue="100" MinRange="0" SmallChange="1"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center" Margin="7,0,0,0" Height="41">
            <mah:ToggleSwitch x:Name="ToggleEnabled" Header="Debugging" Margin="0,5,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsOn="True"/>
            <Button x:Name="WatchTargetMenuButton" Content="+ Watch..." Margin="12,5,0,0" Padding="11,5"
                    VerticalAlignment="Center" Click="WatchTargetMenuButton_Click"/>
            <Popup x:Name="WatchTargetPopup" PlacementTarget="{Binding ElementName=WatchTargetMenuButton}"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="500" MaxHeight="520" Margin="0,0,0,7" Padding="14" Background="#FF181D21"
                        BorderBrush="#FF4A555E" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Add a watch target" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,3,0,10" Foreground="#FF9DA9A3" TextWrapping="Wrap"
                                   Text="Choose a currently open WPF window or a loaded type with static fields and properties. Non-null static object instances become recursive watches."/>
                        <TextBlock Text="Search" Foreground="#FFD8DFDB"/>
                        <TextBox x:Name="TargetFilterTextBox" Height="28" Margin="0,4,0,7" Padding="7,3"
                                 TextChanged="TargetFilterTextBox_TextChanged"
                                 ToolTip="Filter by window title, type, namespace, or assembly"/>
                        <ComboBox x:Name="AvailableTargetsComboBox" Height="30" Margin="0,0,0,10"
                                  Style="{StaticResource DarkComboBoxStyle}" MaxDropDownHeight="320"
                                  IsTextSearchEnabled="True" TextSearch.TextPath="SearchText"/>
                        <WrapPanel>
                            <Button x:Name="AddTargetButton" Content="Add selected" Padding="11,5" Click="AddTargetButton_Click"/>
                            <Button x:Name="AddAllWindowsButton" Content="Watch all windows" Margin="6,0,0,0" Padding="11,5" Click="AddAllWindowsButton_Click"/>
                            <Button x:Name="RefreshTargetsButton" Content="Refresh" Margin="6,0,0,0" Padding="11,5" Click="RefreshTargetsButton_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="TargetStatusText" Margin="0,8,0,0" Foreground="#FF93A099" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
