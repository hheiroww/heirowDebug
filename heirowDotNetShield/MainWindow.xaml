<Window x:Class="HeirowDotNetShield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="heirowDotNetShield"
        Width="920" Height="690" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0A0C12" Foreground="#F5F7FF">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#121722" />
        <SolidColorBrush x:Key="Border" Color="#263044" />
        <SolidColorBrush x:Key="Muted" Color="#AAB5CA" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="#306CFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#090C13" />
            <Setter Property="Foreground" Value="#F5F7FF" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E9EDFA" />
            <Setter Property="Margin" Value="0,7" />
        </Style>
    </Window.Resources>

    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="heirowDotNetShield" FontSize="30" FontWeight="Bold" />
            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Muted}"
                       Text="Offline hardening for a copied .NET application build" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,24,0,0" Padding="18" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Application assembly" FontWeight="SemiBold" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputPathTextBox" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Content="Browse DLL" Click="BrowseInput_Click" />
                </Grid>

                <TextBlock Margin="0,16,0,0" Text="Protected output directory" FontWeight="SemiBold" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputPathTextBox" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Content="Choose folder" Click="BrowseOutput_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="18" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <CheckBox IsChecked="True" IsEnabled="False" Content="Block .NET startup-hook injection" />
                    <CheckBox IsChecked="True" IsEnabled="False" Content="Close managed diagnostic/attach channel" />
                    <CheckBox IsChecked="True" IsEnabled="False" Content="Disable hot-reload metadata updates" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <CheckBox IsChecked="True" IsEnabled="False" Content="Obfuscate private implementation names" />
                    <CheckBox IsChecked="True" IsEnabled="False" Content="Hide managed string literals" />
                    <CheckBox IsChecked="True" IsEnabled="False" Content="Remove PDB symbol files" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0" Padding="14" Background="#1A1522"
                BorderBrush="#5F3B72" BorderThickness="1" CornerRadius="8">
            <TextBlock TextWrapping="Wrap" Foreground="#D8C3E5"
                       Text="Security boundary: a native pre-runtime launcher prevents Jack-Debug's launch-time startup hook and standard managed debugger attachment. It does not make same-user administrator or native memory access impossible. The original build is never modified." />
        </Border>

        <Border Grid.Row="4" Margin="0,14,0,0" Padding="14" Background="#070A10"
                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" FontFamily="Cascadia Mono" FontSize="12.5"
                           Foreground="#B9C8E8" TextWrapping="Wrap" Text="Ready." />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="5" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                       Text="Select the main application DLL from a Release build." />
            <Button x:Name="ProtectButton" Grid.Column="1" Margin="12,0,0,0"
                    Padding="28,12" Content="Create protected build" Click="Protect_Click" />
        </Grid>
    </Grid>
</Window>
