<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>heirowDotNetShield</AssemblyName>
    <RootNamespace>HeirowDotNetShield</RootNamespace>
    <Product>heirowDotNetShield 2026</Product>
    <Title>heirowDotNetShield 2026</Title>
    <ApplicationIcon>..\Assets\heirowDotNetShield.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\Assets\heirowDotNetShield.ico" Link="Assets\heirowDotNetShield.ico" />
    <PackageReference Include="Obfuscar" Version="2.2.50" />
  </ItemGroup>

  <PropertyGroup>
    <ShieldLauncherPublishDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\ShieldLauncher\</ShieldLauncherPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(ShieldLauncherPublishDir)heirowDotNetShield.Launcher.exe"
          Link="ShieldLauncher\heirowDotNetShield.Launcher.exe"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)obfuscar\2.2.50\tools\**\*"
          Link="Obfuscar\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildShieldLauncher" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\heirowDotNetShield.Launcher\heirowDotNetShield.Launcher.csproj"
             Targets="Restore"
             BuildInParallel="false"
             Properties="RuntimeIdentifier=win-x64;BaseIntermediateOutputPath=$(ShieldLauncherPublishDir)intermediate\;BaseOutputPath=$(ShieldLauncherPublishDir)build\" />
    <MSBuild Projects="..\heirowDotNetShield.Launcher\heirowDotNetShield.Launcher.csproj"
             Targets="Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(ShieldLauncherPublishDir);BaseIntermediateOutputPath=$(ShieldLauncherPublishDir)intermediate\;BaseOutputPath=$(ShieldLauncherPublishDir)build\" />
    <MakeDir Directories="$(TargetDir)ShieldLauncher" />
    <Copy SourceFiles="$(ShieldLauncherPublishDir)heirowDotNetShield.Launcher.exe"
          DestinationFolder="$(TargetDir)ShieldLauncher" />
  </Target>
</Project>
